+
+### Closed syncmer triggers (text/AGC only)
+
+`--syncmer-s S` selects a closed syncmer trigger: among the `S`-mers in the
+last `K` bytes (`-w K`), the minimum hash must occur at the first or last position.
+Equal minima qualify. With no `--syncmer-s`, the original mod-`p` trigger is
+unchanged. `-p` is ignored for first-level syncmer trigger selection.
+
+`--syncmer-canonical` uses the smaller hash of each DNA
+`S`-mer and its reverse complement. A/C/G/T are complemented; other bytes,
+including N and the 0x1e separator, are self-complementary. Web text should
+leave this flag off. The selector consumes each byte once with O(K) memory;
+its state is not reset at phrase or source block boundaries. The PFP overlap
+remains K, so a trigger's content is fully present in adjacent phrases.
+
+The bound of `K-S` is on the gap between consecutive triggers. A normal
+phrase is at most `K+(K-S)` bytes; the final phrase additionally appends K
+end markers. Existing endpoint and slim tools in SXI currently assume
+`K=10`, so larger K values are for parser measurements until they are
+parameterized downstream.
diff --git a/include/closed_syncmer.hpp b/include/closed_syncmer.hpp
new file mode 100644
index 0000000..ba139e4
--- /dev/null
+++ b/include/closed_syncmer.hpp
@@ -0,0 +1,79 @@
+#ifndef PFP_CLOSED_SYNCMER_HPP
+#define PFP_CLOSED_SYNCMER_HPP
+
+#include <cstdint>
+#include <deque>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace vcfbwt { namespace pfp {
+
+// Streaming closed syncmer selector: the minimum s-mer hash in a k-mer
+// must occur at either end. Equal minima qualify at either endpoint.
+class ClosedSyncmer {
+    const uint32_t s_, q_;
+    const bool canonical_;
+    std::vector<uint8_t> bases_;
+    std::vector<uint64_t> endpoints_;
+    std::deque<std::pair<uint64_t, uint64_t>> minima_;
+    uint64_t base_power_ = 1, rolling_ = 0, characters_ = 0, smers_ = 0;
+
+    static uint64_t mix(uint64_t x) {
+        x += 0x9e3779b97f4a7c15ULL;
+        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+        x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+        return x ^ (x >> 31);
+    }
+    static uint8_t complement(uint8_t c) {
+        switch (c) {
+            case 'A': return 'T'; case 'a': return 't';
+            case 'C': return 'G'; case 'c': return 'g';
+            case 'G': return 'C'; case 'g': return 'c';
+            case 'T': return 'A'; case 't': return 'a';
+            default: return c; // N and 0x1e are self-complementary
+        }
+    }
+public:
+    ClosedSyncmer(uint32_t k, uint32_t s, bool canonical)
+        : s_(s), q_(s < k ? k - s + 1 : 1), canonical_(canonical), bases_(s), endpoints_(q_) {
+        if (!s || s >= k)
+            throw std::invalid_argument("closed syncmer needs 1 <= s < k");
+        for (uint32_t i = 1; i < s; ++i) base_power_ *= 257;
+    }
+    bool push(uint8_t c) {
+        if (characters_ < s_) {
+            bases_[characters_ % s_] = c;
+            rolling_ = rolling_ * 257 + c;
+            ++characters_;
+            if (characters_ < s_) return false;
+        } else {
+            const uint64_t slot = characters_ % s_;
+            const uint8_t old = bases_[slot];
+            bases_[slot] = c;
+            rolling_ = (rolling_ - old * base_power_) * 257 + c;
+            ++characters_;
+        }
+        uint64_t hash = mix(rolling_);
+        if (canonical_) {
+            uint64_t reverse = 0;
+            for (uint32_t i = 0; i < s_; ++i)
+                reverse = reverse * 257 +
+                    complement(bases_[(characters_ + s_ - 1 - i) % s_]);
+            const uint64_t r = mix(reverse);
+            if (r < hash) hash = r;
+        }
+        const uint64_t index = smers_++;
+        endpoints_[index % q_] = hash;
+        while (!minima_.empty() && minima_.back().second > hash) minima_.pop_back();
+        minima_.emplace_back(index, hash);
+        if (smers_ < q_) return false;
+        const uint64_t first = index - q_ + 1;
+        while (minima_.front().first < first) minima_.pop_front();
+        const uint64_t minimum = minima_.front().second;
+        return endpoints_[first % q_] == minimum || hash == minimum;
+    }
+};
+
+}} // namespace vcfbwt::pfp
+#endif
