@@ -0,0 +1,20 @@
+#ifndef PFP_TEXT_SOURCE_HPP
+#define PFP_TEXT_SOURCE_HPP
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+namespace vcfbwt { namespace pfp {
+// Sequential consumption of bounded chunks; an AGC source fetches each chunk
+// at its logical collection offset using independent decoder sessions.
+class TextSource {
+public:
+    virtual ~TextSource() = default;
+    virtual std::size_t read(char* output, std::size_t capacity) = 0;
+    virtual uint64_t size() const = 0;
+    virtual void seek(uint64_t offset, uint64_t length = UINT64_MAX) = 0;
+};
+std::unique_ptr<TextSource> open_text_source(const std::string& path, bool agc,
+    std::size_t threads = 1, const std::string& names_path = "");
+} }
+#endif
diff --git a/src/agc_source.cpp b/src/agc_source.cpp
new file mode 100644
index 0000000..052180f
--- /dev/null
+++ b/src/agc_source.cpp
@@ -0,0 +1,217 @@
+#ifdef PFP_ENABLE_AGC
+#include "agc_source.hpp"
+#include <agc_decompressor_lib.h>
+#include <algorithm>
+#include <exception>
+#include <fstream>
+#include <limits>
+#include <unordered_map>
+#include <stdexcept>
+#include <omp.h>
+namespace vcfbwt { namespace pfp { namespace {
+constexpr std::size_t BLOCK = 1 << 20;
+constexpr uint64_t MAX_PACK = 256ULL << 20;
+struct Part { uint64_t base; uint32_t length, skip; segment_desc_t desc; };
+struct Row { uint64_t base, length; std::string name; std::vector<Part> parts; };
+struct Layout { std::vector<Row> rows; uint64_t total = 0; };
+void require(bool ok, const char* message) { if (!ok) throw std::runtime_error(message); }
+// The public C API sorts samples and its advertised lengths can disagree with
+// decoded output. Use the pinned library's collection/segment interface instead.
+class Session : public CAGCDecompressorLibrary {
+    std::unordered_map<uint64_t, std::vector<uint32_t>> pack_lengths;
+    std::unordered_map<uint32_t, uint64_t> reference_lengths;
+    ZSTD_DCtx* zstd = nullptr;
+    static int64_t number(const std::vector<uint8_t>& v, std::size_t& p, std::size_t end) {
+        bool neg = p < end && v[p] == '-'; if (neg) ++p;
+        int64_t n = 0; bool seen = false;
+        while (p < end && v[p] >= '0' && v[p] <= '9') {
+            seen = true; require(n <= INT32_MAX / 10, "AGC integer overflow");
+            n = n * 10 + v[p++] - '0';
+        }
+        require(seen, "Invalid AGC delta integer"); return neg ? -n : n;
+    }
+    uint64_t delta_length(const std::vector<uint8_t>& v, std::size_t b, std::size_t e, uint64_t ref) {
+        // An empty encoding denotes an identical copy of the reference.
+        if (b == e) return ref;
+        uint64_t length = 0, predicted = 0; std::size_t p = b;
+        while (p < e) {
+            auto c = v[p];
+            if ((c >= 'A' && c <= 'U') || c == '!') { ++length; ++predicted; ++p; }
+            else if (c == 30) {
+                ++p; auto n = number(v, p, e); require(n >= 0, "Invalid AGC N run");
+                length += n + 4; require(p < e && v[p++] == 4, "Invalid AGC N run suffix");
+            } else {
+                int64_t pos = static_cast<int64_t>(predicted) + number(v, p, e);
+                require(pos >= 0 && static_cast<uint64_t>(pos) <= ref, "Invalid AGC match position");
+                uint64_t n;
+                if (p < e && v[p] == ',') {
+                    ++p; auto raw = number(v, p, e); require(raw >= 0, "Invalid AGC match length");
+                    n = raw + min_match_len;
+                } else n = ref - pos;
+                require(p < e && v[p++] == '.' && n <= ref - pos, "Invalid AGC match");
+                predicted = pos + n; length += n;
+            }
+            require(length <= UINT32_MAX, "AGC segment too long");
+        }
+        return length;
+    }
+    uint32_t segment_length(const segment_desc_t& d) {
+        uint32_t group = d.group_id, id = d.in_group_id;
+        auto base = ss_base(archive_version, group); uint64_t ref = 0;
+        if (group >= no_raw_groups) {
+            auto it = reference_lengths.find(group);
+            if (it == reference_lengths.end()) {
+                std::vector<uint8_t> packed; uint64_t n = 0;
+                auto result = in_archive->GetPart(base + ss_ref_ext(archive_version), 0, packed, n);
+                require(result.second, "Missing AGC reference");
+                ref = n ? n : packed.size(); require(ref <= MAX_PACK, "AGC reference exceeds 256 MiB bound");
+                reference_lengths.emplace(group, ref);
+            } else ref = it->second;
+            if (id == 0) return ref;
+            --id;
+        }
+        auto part = id / pack_cardinality;
+        uint64_t key = (uint64_t(group) << 32) | part;
+        auto it = pack_lengths.find(key);
+        if (it == pack_lengths.end()) {
+            std::vector<uint8_t> packed, raw; uint64_t n = 0;
+            auto result = in_archive->GetPart(base + ss_delta_ext(archive_version), part, packed, n);
+            require(result.second, "Missing AGC delta pack");
+            require(n <= MAX_PACK && packed.size() <= MAX_PACK, "AGC pack exceeds 256 MiB bound");
+            if (n) {
+                require(!packed.empty() && packed.back() == 0, "Invalid AGC pack marker");
+                raw.resize(n);
+                auto got = ZSTD_decompressDCtx(zstd, raw.data(), raw.size(), packed.data(), packed.size() - 1);
+                require(!ZSTD_isError(got) && got == n, "Invalid compressed AGC pack");
+            } else raw = std::move(packed);
+            std::vector<uint32_t> lengths; std::size_t b = 0;
+            for (std::size_t e = 0; e < raw.size(); ++e) if (raw[e] == 255) {
+                lengths.push_back(group < no_raw_groups ? e - b : delta_length(raw, b, e, ref)); b = e + 1;
+            }
+            require(b == raw.size(), "Unterminated AGC pack");
+            it = pack_lengths.emplace(key, std::move(lengths)).first;
+        }
+        auto length = it->second.at(id % pack_cardinality);
+        require(length <= MAX_PACK, "AGC decoded segment exceeds 256 MiB bound");
+        return length;
+    }
+public:
+    explicit Session(const std::string& path) : CAGCDecompressorLibrary(false) {
+        require(Open(path, false), "Cannot open AGC archive");
+        require(archive_version >= 3000 && archive_version < 4000, "AGC input currently supports archive version 3");
+        zstd = ZSTD_createDCtx(); require(zstd != nullptr, "Cannot allocate AGC decoder");
+    }
+    ~Session() { ZSTD_freeDCtx(zstd); }
+    Layout index() {
+        Layout layout; std::vector<std::string> samples;
+        require(collection_desc->get_samples_list(samples, false), "Cannot list AGC samples");
+        for (const auto& sample : samples) {
+            std::vector<std::string> contigs;
+            require(ListContigs(sample, contigs), "Cannot list AGC contigs");
+            for (const auto& contig : contigs) {
+                require(contig.find_first_of("\t\r\n") == std::string::npos, "AGC contig name is not TSV-safe");
+                Row row; row.base = layout.total; row.length = 0; row.name = contig;
+                std::string full_name = contig; std::vector<segment_desc_t> descriptors;
+                require(collection_desc->get_contig_desc(sample, full_name, descriptors), "Cannot read AGC descriptors");
+                for (std::size_t i = 0; i < descriptors.size(); ++i) {
+                    auto n = segment_length(descriptors[i]); auto skip = i ? kmer_length : 0;
+                    require(n >= skip, "AGC segment shorter than its overlap");
+                    row.parts.push_back(Part{row.length, n, skip, descriptors[i]}); row.length += n - skip;
+                }
+                require(row.length < UINT64_MAX - layout.total, "AGC collection size overflow");
+                layout.total += row.length + 1; layout.rows.push_back(std::move(row));
+            }
+        }
+        require(layout.total != 0, "Empty AGC collection");
+        pack_lengths.clear(); pack_lengths.rehash(0); reference_lengths.clear();
+        return layout;
+    }
+    void read(const Layout& layout, uint64_t offset, char* out, std::size_t count) {
+        static const char alphabet[] = "ACGTNRYSWKMBDHVU";
+        require(offset <= layout.total && count <= layout.total - offset, "AGC range outside collection");
+        auto it = std::upper_bound(layout.rows.begin(), layout.rows.end(), offset,
+            [](uint64_t p, const Row& row) { return p < row.base; });
+        if (count == 0) return;
+        --it; uint64_t end = offset + count;
+        while (offset < end) {
+            const auto& row = *it; auto local = offset - row.base;
+            if (local == row.length) { *out++ = 30; ++offset; ++it; continue; }
+            auto take = std::min(end - offset, row.length - local);
+            auto first = row.length - local - take, last = first + take;
+            auto part = std::upper_bound(row.parts.begin(), row.parts.end(), first,
+                [](uint64_t p, const Part& x) { return p < x.base; });
+            if (part != row.parts.begin()) --part;
+            for (; part != row.parts.end() && part->base < last; ++part) {
+                const auto& x = *part; auto finish = x.base + x.length - x.skip;
+                if (finish <= first) continue;
+                contig_t raw;
+                require(decompress_segment(x.desc.group_id, x.desc.in_group_id, raw, zstd), "AGC segment decode failed");
+                if (raw.empty() && x.length && x.desc.group_id >= no_raw_groups)
+                    require(decompress_segment(x.desc.group_id, 0, raw, zstd), "AGC identical segment decode failed");
+                require(raw.size() == x.length, "AGC decoded length differs from compressed index");
+                auto lo = std::max(first, x.base), hi = std::min(last, finish);
+                for (auto p = lo; p < hi; ++p) {
+                    auto k = p - x.base + x.skip;
+                    auto b = raw[x.desc.is_rev_comp ? raw.size() - 1 - k : k];
+                    if (x.desc.is_rev_comp && b < 4) b = 3 - b;
+                    require(b != 30, "Reserved AGC separator in sequence content");
+                    out[last - 1 - p] = b < 16 ? alphabet[b] : 'N';
+                }
+            }
+            offset += take; out += take;
+        }
+    }
+};
+class AgcSource : public TextSource {
+    Layout layout;
+    std::vector<std::unique_ptr<Session>> sessions;
+    std::vector<char> buffer;
+    uint64_t position = 0, range_end = 0;
+    std::size_t consumed = 0, available = 0;
+public:
+    AgcSource(const std::string& path, std::size_t threads, const std::string& names) {
+        require(threads > 0 && threads <= 96, "AGC decoder threads must be 1..96");
+        { Session indexer(path); layout = indexer.index(); }
+        range_end = layout.total;
+        threads = std::min<uint64_t>(threads, (layout.total + BLOCK - 1) / BLOCK);
+        sessions.resize(threads); buffer.resize(threads * BLOCK);
+        std::vector<std::exception_ptr> errors(threads);
+        #pragma omp parallel for num_threads(threads)
+        for (std::size_t i = 0; i < threads; ++i) {
+            try { sessions[i].reset(new Session(path)); } catch (...) { errors[i] = std::current_exception(); }
+        }
+        for (auto& e : errors) if (e) std::rethrow_exception(e);
+        if (!names.empty()) {
+            std::ofstream f(names); require(bool(f), "Cannot create AGC names sidecar");
+            for (const auto& r : layout.rows) f << r.name << '\t' << layout.total - 1 - r.base - r.length << '\t' << r.length << '\n';
+            f.close(); require(bool(f), "Cannot write AGC names sidecar");
+        }
+    }
+    uint64_t size() const override { return layout.total; }
+    void seek(uint64_t offset, uint64_t length) override {
+        require(offset <= layout.total, "AGC seek outside collection"); position = offset; range_end = offset + std::min(length, layout.total - offset); consumed = available = 0;
+    }
+    std::size_t read(char* out, std::size_t capacity) override {
+        if (!capacity || position == range_end) return 0;
+        if (consumed == available) {
+            available = std::min<uint64_t>(buffer.size(), range_end - position); consumed = 0;
+            std::vector<std::exception_ptr> errors(sessions.size());
+            #pragma omp parallel for num_threads(sessions.size())
+            for (std::size_t i = 0; i < sessions.size(); ++i) {
+                auto begin = i * BLOCK;
+                if (begin >= available) continue;
+                try { sessions[i]->read(layout, position + begin, buffer.data() + begin, std::min(BLOCK, available - begin)); }
+                catch (...) { errors[i] = std::current_exception(); }
+            }
+            for (auto& e : errors) if (e) std::rethrow_exception(e);
+        }
+        auto n = std::min(capacity, available - consumed);
+        std::copy_n(buffer.data() + consumed, n, out); consumed += n; position += n; return n;
+    }
+};
+} // namespace
+std::unique_ptr<TextSource> open_agc_source(const std::string& path, std::size_t threads, const std::string& names) {
+    return std::unique_ptr<TextSource>(new AgcSource(path, threads, names));
+}
+} }
+#endif
