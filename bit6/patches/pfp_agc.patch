+#!/usr/bin/env python3
+"""Native AGC/file parse equivalence and seek/separator regressions."""
+import argparse, os, pathlib, random, subprocess, tempfile
+p=argparse.ArgumentParser();p.add_argument('--pfp',required=True);p.add_argument('--probe',required=True);p.add_argument('--agc',required=True);p.add_argument('--agc2flat',required=True);a=p.parse_args()
+def run(cmd,**kw): return subprocess.run(list(map(str,cmd)),check=True,**kw)
+with tempfile.TemporaryDirectory(prefix='pfp-agc-test-') as tmp:
+ d=pathlib.Path(tmp); rng=random.Random(512); inputs=[]
+ for sample in range(2):
+  fa=d/f'sample{sample}.fa';fa.write_bytes(b'>shared\n'+bytes(rng.choice(b'ACGTN') for _ in range(1050001+sample))+b'\n>tiny\nacgtnryswkmbdhvu\n>periodic\n'+b'ACGT'*5000+b'\n');inputs.append(fa)
+ archive=d/'input.agc';run([a.agc,'create','-t','2','-o',archive,*inputs],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+ flat=d/'control.txt';run([a.agc2flat,archive,'--revlines','--upper','--sep','1e','-o',flat],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+ expected=flat.read_bytes()
+ for j in [1,16,48,96]:
+  prefix=d/f'native{j}';names=d/f'names{j}.tsv'
+  run([a.pfp,'-t',archive,'--agc','--agc-names',names,'-j',j,'-w','10','-p','100','-o',prefix,'--tmp-dir',d],stdout=subprocess.DEVNULL)
+  assert names.read_bytes()==pathlib.Path(str(flat)+'.names.tsv').read_bytes()
+  if j==1:run([a.pfp,'-t',flat,'-j',j,'-w','10','-p','100','-o',d/'file','--tmp-dir',d],stdout=subprocess.DEVNULL)
+  for ext in ['parse','dict']:assert (d/f'native{j}.{ext}').read_bytes()==(d/f'file.{ext}').read_bytes()
+ ranges=[(0,len(expected)),(len(expected),0)]
+ ranges += [(max(0,i-5),min(15,len(expected)-max(0,i-5))) for i,b in enumerate(expected) if b==30]
+ ranges += [(rng.randrange(len(expected)),rng.randrange(300)) for _ in range(30)]
+ proc=subprocess.Popen([a.probe,'agc',str(archive),'16','requests','0','emit'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
+ for offset,n in ranges:
+  n=min(n,len(expected)-offset);proc.stdin.write(f'{offset} {n}\n'.encode());proc.stdin.flush();assert proc.stdout.read(n)==expected[offset:offset+n]
+ proc.stdin.close();assert proc.wait()==0
+ bad=subprocess.run([a.probe,'agc',str(archive),'1',str(len(expected)+1),'1'],capture_output=True)
+ assert bad.returncode!=0
+ print('PASS: four thread counts; parse/dict/names byte-identical; whole stream, random seeks, separators, EOF, invalid range')
