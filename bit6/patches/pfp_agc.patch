@@ -0,0 +1,34 @@
+#include <text_source.hpp>
+#include <chrono>
+#include <iostream>
+#include <vector>
+#include <algorithm>
+int main(int argc, char** argv) {
+    try {
+        if (argc < 6) { std::cerr << "source_probe agc|file PATH THREADS OFFSET LENGTH [emit]\n"; return 2; }
+        auto begin = std::chrono::steady_clock::now();
+        auto source = vcfbwt::pfp::open_text_source(argv[2], std::string(argv[1]) == "agc", std::stoul(argv[3]));
+        auto start = std::chrono::steady_clock::now();
+        bool requests = std::string(argv[4]) == "requests";
+        uint64_t offset, length;
+        do {
+        if (requests) { if (!(std::cin >> offset >> length)) break; }
+        else { offset = std::stoull(argv[4]); length = std::stoull(argv[5]); }
+        auto read_start = std::chrono::steady_clock::now();
+        source->seek(offset, length); uint64_t left = length, bytes = 0, hash = 14695981039346656037ULL;
+        std::vector<char> block(1 << 20);
+        while (left) {
+            auto n = source->read(block.data(), std::min<uint64_t>(left, block.size()));
+            if (!n) throw std::runtime_error("Short source read");
+            if (argc > 6) std::cout.write(block.data(), n);
+            else for (std::size_t i = 0; i < n; ++i) { hash ^= static_cast<unsigned char>(block[i]); hash *= 1099511628211ULL; }
+            left -= n; bytes += n;
+        }
+        auto end = std::chrono::steady_clock::now();
+        double init = std::chrono::duration<double>(start - begin).count(), seconds = std::chrono::duration<double>(end - read_start).count();
+        std::cerr << "{\"bytes\":" << bytes << ",\"init_seconds\":" << init << ",\"read_seconds\":" << seconds
+                  << ",\"MB_per_s\":" << bytes / 1e6 / seconds << ",\"hash\":" << hash << "}\n";
+        std::cout.flush(); std::cerr.flush();
+        } while (requests);
+    } catch (const std::exception& e) { std::cerr << e.what() << '\n'; return 1; }
+}
