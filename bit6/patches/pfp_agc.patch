diff --git a/include/byte_remap.hpp b/include/byte_remap.hpp
new file mode 100644
index 0000000..1af6a2a
--- /dev/null
+++ b/include/byte_remap.hpp
@@ -0,0 +1,42 @@
+#pragma once
+#include <array>
+#include <algorithm>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+
+namespace vcfbwt { namespace pfp {
+// A permutation of all 256 bytes, injective into [6,255] on the observed
+// alphabet. Only unseen source entries may change. No prepass or text spool.
+// Separator 0x1e is pinned, including before its first occurrence.
+class ByteRemap {
+    std::array<unsigned char,256> sigma{}, inverse{};
+    std::array<bool,256> seen{};
+public:
+    ByteRemap() {
+        for (unsigned i=0;i<256;++i) sigma[i]=inverse[i]=i;
+        seen[0x1e]=true;
+    }
+    unsigned char map(unsigned char c) {
+        if (!seen[c]) {
+            if (sigma[c]<=5) {
+                int target=255;
+                while(target>=6 && seen[inverse[target]]) --target;
+                if(target<6) throw std::runtime_error(
+                    "Byte alphabet exceeds 250 codes (249 plus reserved 0x1e); escape encoding is not supported");
+                unsigned char displaced=inverse[target], old=sigma[c];
+                sigma[c]=target; sigma[displaced]=old;
+                inverse[target]=c; inverse[old]=displaced;
+            }
+            seen[c]=true;
+        }
+        return sigma[c];
+    }
+    void save(const std::string& path) const {
+        std::ofstream out(path,std::ios::binary|std::ios::trunc);
+        out.write(reinterpret_cast<const char*>(sigma.data()),sigma.size());
+        out.close();
+        if(!out) throw std::runtime_error("Cannot write byte-remap table: "+path);
+    }
+};
+} }
