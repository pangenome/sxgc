@@ -0,0 +1,39 @@
+#include <text_source.hpp>
+#include <zlib.h>
+#include <algorithm>
+#include <stdexcept>
+#ifdef PFP_ENABLE_AGC
+#include "agc_source.hpp"
+#endif
+namespace vcfbwt { namespace pfp {
+namespace {
+class FileSource : public TextSource {
+    gzFile file;
+public:
+    explicit FileSource(const std::string& path) : file(gzopen(path.c_str(), "rb")) {
+        if (!file) throw std::runtime_error("Cannot open text: " + path);
+    }
+    ~FileSource() { gzclose(file); }
+    std::size_t read(char* out, std::size_t capacity) override {
+        int n = gzread(file, out, std::min<std::size_t>(capacity, 1 << 30));
+        if (n < 0) throw std::runtime_error("Text read failed");
+        return n;
+    }
+    uint64_t size() const override { throw std::runtime_error("File size not available for compressed input"); }
+    void seek(uint64_t offset, uint64_t) override {
+        if (gzseek(file, offset, SEEK_SET) < 0) throw std::runtime_error("Text seek failed");
+    }
+};
+}
+std::unique_ptr<TextSource> open_text_source(const std::string& path, bool agc,
+        std::size_t threads, const std::string& names_path) {
+    if (agc) {
+#ifdef PFP_ENABLE_AGC
+        return open_agc_source(path, threads, names_path);
+#else
+        throw std::runtime_error("AGC input requires a build with PFP_ENABLE_AGC=ON");
+#endif
+    }
+    return std::unique_ptr<TextSource>(new FileSource(path));
+}
+} }
