diff -ruN a/tests/partitioned_dictionary.cpp b/tests/partitioned_dictionary.cpp
--- a/tests/partitioned_dictionary.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/partitioned_dictionary.cpp	2026-09-30 13:02:52.419442247 +0000
@@ -0,0 +1,37 @@
+#include <pfp_algo.hpp>
+#include <thread>
+
+int main()
+{
+    using byte = vcfbwt::char_type;
+    vcfbwt::pfp::Dictionary<byte> partitioned;
+    vcfbwt::pfp::Dictionary<byte> single;
+    partitioned.set_partition_count(16);
+    constexpr std::size_t unique_phrases = 2000;
+    std::vector<std::thread> workers;
+    for (std::size_t worker = 0; worker < 8; ++worker) {
+        workers.emplace_back([&] {
+            for (std::size_t i = 0; i < unique_phrases; ++i) {
+                const std::string text = "phrase-" + std::to_string(i);
+                partitioned.check_and_add(std::vector<byte>(text.begin(), text.end()));
+            }
+        });
+    }
+    for (auto& worker : workers) worker.join();
+    if (partitioned.size() != unique_phrases) return 1;
+    for (std::size_t i = 0; i < unique_phrases; ++i) {
+        const std::string text = "phrase-" + std::to_string(i);
+        single.check_and_add(std::vector<byte>(text.begin(), text.end()));
+    }
+    partitioned.sort();
+    single.sort();
+    for (std::size_t i = 0; i < unique_phrases; ++i) {
+        if (partitioned.sorted_entry_at(i) != single.sorted_entry_at(i)) return 2;
+    }
+    const std::string extra = "zzzz";
+    partitioned.check_and_add(std::vector<byte>(extra.begin(), extra.end()));
+    partitioned.sort();
+    if (partitioned.size() != unique_phrases + 1 ||
+        partitioned.sorted_entry_at(unique_phrases) != std::pmr::vector<byte>(extra.begin(), extra.end())) return 3;
+    return 0;
+}
diff -ruN a/tests/test_closed_syncmer.cpp b/tests/test_closed_syncmer.cpp
--- a/tests/test_closed_syncmer.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_closed_syncmer.cpp	2026-09-30 12:26:07.233595487 +0000
@@ -0,0 +1,70 @@
+#include <closed_syncmer.hpp>
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using vcfbwt::pfp::ClosedSyncmer;
+
+static uint64_t hash_smer(const std::string& text, int start, int s) {
+    uint64_t x = 0;
+    for (int i = 0; i < s; ++i)
+        x = x * 257 + static_cast<uint8_t>(text[start+i]);
+    x += 0x9e3779b97f4a7c15ULL;
+    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+    return x ^ (x >> 31);
+}
+
+static std::vector<int> selected(const std::string& text, int k, int s, bool canonical) {
+    ClosedSyncmer scanner(k, s, canonical);
+    std::vector<int> positions;
+    for (int i = 0; i < static_cast<int>(text.size()); ++i)
+        if (scanner.push(static_cast<uint8_t>(text[i]))) positions.push_back(i);
+    return positions;
+}
+
+int main() {
+    bool rejected = false;
+    try { ClosedSyncmer invalid(10, 10, false); }
+    catch (const std::invalid_argument&) { rejected = true; }
+    assert(rejected);
+    std::string dna;
+    uint32_t state = 7;
+    for (int i = 0; i < 100000; ++i) {
+        state = state * 1664525 + 1013904223;
+        dna.push_back("ACGT"[state >> 30]);
+    }
+    for (int k : {10, 30, 100}) {
+        const int s = 5;
+        const auto hits = selected(dna, k, s, false);
+        assert(!hits.empty());
+        for (size_t i = 1; i < hits.size(); ++i) assert(hits[i] - hits[i-1] <= k-s+1);
+        auto canonical_hits = selected(dna, k, s, true);
+        std::string reverse(dna.rbegin(), dna.rend());
+        for (char& c : reverse) c = c == 'A' ? 'T' : c == 'T' ? 'A' : c == 'C' ? 'G' : 'C';
+        auto reverse_hits = selected(reverse, k, s, true);
+        std::reverse(reverse_hits.begin(), reverse_hits.end());
+        for (int& position : reverse_hits) position = static_cast<int>(dna.size()) - 1 - position + k - 1;
+        assert(canonical_hits == reverse_hits);
+    }
+    std::string text = dna.substr(0, 1000) + "  punctuation, N; words!";
+    const auto observed = selected(text, 13, 4, false);
+    std::vector<int> expected;
+    for (int end = 12; end < static_cast<int>(text.size()); ++end) {
+        uint64_t first = hash_smer(text, end-12, 4);
+        uint64_t last = hash_smer(text, end-3, 4);
+        uint64_t minimum = first;
+        for (int start = end-11; start <= end-3; ++start)
+            minimum = std::min(minimum, hash_smer(text, start, 4));
+        if (first == minimum || last == minimum) expected.push_back(end);
+    }
+    assert(observed == expected);
+    const auto tied = selected(std::string(1000, 'A'), 20, 4, false);
+    assert(tied.size() == 981); // equal endpoint hashes select every k-mer
+    auto with_separator = selected(std::string(50, 'A') + '\x1e' + std::string(50, 'A'), 20, 4, true);
+    for (size_t i = 1; i < with_separator.size(); ++i)
+        assert(with_separator[i] - with_separator[i-1] <= 17);
+}
