diff -ruN a/README.md b/README.md
--- a/README.md	2026-09-29 14:50:53.803226744 +0000
+++ b/README.md	2026-09-30 13:00:49.088450818 +0000
@@ -168,3 +168,22 @@
 Run `tests/test_agc.py --pfp build/pfp++ --probe build/pfp_source_probe
 --agc /path/to/agc --agc2flat /path/to/agc2flat` for parse/dictionary,
 names, seek, separator, and error regressions.
+
+### Dictionary partitions and trigger modes
+
+`-j N` gives the dictionary N hash-owned partitions, each with its own lock
+and allocation pool. A phrase is stored in exactly one partition. The global
+lexicographic sort still determines parse ranks, so changing `-j` does not
+change `.parse`, `.dict`, or `.remap` bytes. For plain text, parsing itself is
+currently serial; `-j` does not create parse workers.
+
+`--syncmer-s S` selects closed syncmer triggers on text or AGC input, with
+`-w` as the k-mer length. `--syncmer-canonical` canonicalizes DNA s-mers by
+reverse complement. Omitting `--syncmer-s` retains the mod-`p` trigger.
+
+Set `PFP_PROFILE=1` to print opt-in wall-time counters for dictionary hash,
+lock wait, lookup, insert, rehash, sorting, rank lookup, and output writes.
+The profile explicitly times growth calls when a partition reaches its load
+threshold, so profiling changes the growth schedule and is for diagnosis.
+`sort_ms` includes rank-map growth; `rank_rehash_ms` is that subset of the
+sort time. The measured counters are wall time and can vary with host load.
diff -ruN a/include/closed_syncmer.hpp b/include/closed_syncmer.hpp
--- a/include/closed_syncmer.hpp	1970-01-01 00:00:00.000000000 +0000
+++ b/include/closed_syncmer.hpp	2026-09-30 12:26:07.233595487 +0000
@@ -0,0 +1,79 @@
+#ifndef PFP_CLOSED_SYNCMER_HPP
+#define PFP_CLOSED_SYNCMER_HPP
+
+#include <cstdint>
+#include <deque>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace vcfbwt { namespace pfp {
+
+// Streaming closed syncmer selector: the minimum s-mer hash in a k-mer
+// must occur at either end. Equal minima qualify at either endpoint.
+class ClosedSyncmer {
+    const uint32_t s_, q_;
+    const bool canonical_;
+    std::vector<uint8_t> bases_;
+    std::vector<uint64_t> endpoints_;
+    std::deque<std::pair<uint64_t, uint64_t>> minima_;
+    uint64_t base_power_ = 1, rolling_ = 0, characters_ = 0, smers_ = 0;
+
+    static uint64_t mix(uint64_t x) {
+        x += 0x9e3779b97f4a7c15ULL;
+        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+        x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+        return x ^ (x >> 31);
+    }
+    static uint8_t complement(uint8_t c) {
+        switch (c) {
+            case 'A': return 'T'; case 'a': return 't';
+            case 'C': return 'G'; case 'c': return 'g';
+            case 'G': return 'C'; case 'g': return 'c';
+            case 'T': return 'A'; case 't': return 'a';
+            default: return c; // N and 0x1e are self-complementary
+        }
+    }
+public:
+    ClosedSyncmer(uint32_t k, uint32_t s, bool canonical)
+        : s_(s), q_(s < k ? k - s + 1 : 1), canonical_(canonical), bases_(s), endpoints_(q_) {
+        if (!s || s >= k)
+            throw std::invalid_argument("closed syncmer needs 1 <= s < k");
+        for (uint32_t i = 1; i < s; ++i) base_power_ *= 257;
+    }
+    bool push(uint8_t c) {
+        if (characters_ < s_) {
+            bases_[characters_ % s_] = c;
+            rolling_ = rolling_ * 257 + c;
+            ++characters_;
+            if (characters_ < s_) return false;
+        } else {
+            const uint64_t slot = characters_ % s_;
+            const uint8_t old = bases_[slot];
+            bases_[slot] = c;
+            rolling_ = (rolling_ - old * base_power_) * 257 + c;
+            ++characters_;
+        }
+        uint64_t hash = mix(rolling_);
+        if (canonical_) {
+            uint64_t reverse = 0;
+            for (uint32_t i = 0; i < s_; ++i)
+                reverse = reverse * 257 +
+                    complement(bases_[(characters_ + s_ - 1 - i) % s_]);
+            const uint64_t r = mix(reverse);
+            if (r < hash) hash = r;
+        }
+        const uint64_t index = smers_++;
+        endpoints_[index % q_] = hash;
+        while (!minima_.empty() && minima_.back().second > hash) minima_.pop_back();
+        minima_.emplace_back(index, hash);
+        if (smers_ < q_) return false;
+        const uint64_t first = index - q_ + 1;
+        while (minima_.front().first < first) minima_.pop_front();
+        const uint64_t minimum = minima_.front().second;
+        return endpoints_[first % q_] == minimum || hash == minimum;
+    }
+};
+
+}} // namespace vcfbwt::pfp
+#endif
diff -ruN a/include/parse_profile.hpp b/include/parse_profile.hpp
--- a/include/parse_profile.hpp	1970-01-01 00:00:00.000000000 +0000
+++ b/include/parse_profile.hpp	2026-09-30 13:24:04.299353864 +0000
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstdint>
+#include <spdlog/spdlog.h>
+
+namespace vcfbwt::pfp {
+
+// Opt-in wall time counters. They are deliberately off for production runs.
+struct ParseProfile {
+    using clock = std::chrono::steady_clock;
+    std::atomic<uint64_t> hashes{0}, lock_wait{0}, lookup{0}, insert{0};
+    std::atomic<uint64_t> dictionary_rehash{0}, rank_rehash{0}, output_writes{0}, sort{0}, rank_lookup{0};
+    std::atomic<uint64_t> probes{0}, misses{0}, rehashes{0}, lock_contentions{0};
+
+    static ParseProfile& instance() { static ParseProfile value; return value; }
+    static bool enabled() {
+        static const bool value = [] {
+            const char* setting = std::getenv("PFP_PROFILE");
+            return setting && *setting && *setting != '0';
+        }();
+        return value;
+    }
+    static uint64_t ns(clock::time_point start) {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(clock::now() - start).count();
+    }
+    static void add(std::atomic<uint64_t>& counter, clock::time_point start) {
+        counter.fetch_add(ns(start), std::memory_order_relaxed);
+    }
+    void report(const char* name) const {
+        if (!enabled()) return;
+        spdlog::info("PROFILE {} probes={} misses={} rehashes={} lock_contentions={} hash_ms={} lock_wait_ms={} lookup_ms={} insert_ms={} dictionary_rehash_ms={} rank_rehash_ms={} output_write_ms={} sort_ms={} rank_lookup_ms={}",
+            name, probes.load(), misses.load(), rehashes.load(), lock_contentions.load(), hashes.load()/1e6,
+            lock_wait.load()/1e6, lookup.load()/1e6, insert.load()/1e6,
+            dictionary_rehash.load()/1e6, rank_rehash.load()/1e6,
+            output_writes.load()/1e6, sort.load()/1e6,
+            rank_lookup.load()/1e6);
+    }
+};
+
+} // namespace vcfbwt::pfp
